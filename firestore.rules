rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /game_progress/{uid} {
      // Solo el usuario autenticado puede leer/escribir su propio progreso.
      // Estas reglas protegen privacidad, pero NO validan honestidad del juego:
      // el cliente aún puede falsificar el contenido. Para premios competitivos,
      // mover la validación y la concesión de recompensas a Cloud Functions.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'crystals', 'memoryPassed', 'quizPassed', 'missionCompleted', 'updatedAt'
        ])
        && request.resource.data.crystals is int
        && request.resource.data.crystals >= 0
        && request.resource.data.crystals <= 3
        && request.resource.data.memoryPassed is bool
        && request.resource.data.quizPassed is bool
        && request.resource.data.missionCompleted is bool;
      allow delete: if false;
    }
  }
}
